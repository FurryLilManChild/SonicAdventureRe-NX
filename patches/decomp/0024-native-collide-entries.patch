 static Uint32 player_collide_ground(struct task_work *work,
                                     struct task_motion *motion,
                                     struct player *record);
+/* player_collide_world and its pinball twin keep 16 nearby objects and
+ * write past them when more are near (17 by Final Egg's button platform:
+ * the gate's parts and the floor around it). On the console what that
+ * overwrites is harmless; on AArch64 it was the lift of Sonic's ball over
+ * his feet, which sank him into that floor. Our builds keep 64 and skip,
+ * with a note in the log (each new most), any past that */
+#if defined(NONMATCHING) && !defined(DREAMCAST)
+#define COLLIDE_ENTRIES 64
+#define COLLIDE_FULL(count)                                                   \
+    if ((count) >= COLLIDE_ENTRIES) {                                         \
+        static int told_;                                                     \
+        if (world_count > told_) {                                            \
+            told_ = world_count;                                              \
+            native_hook_note("objects to collide with", world_count,         \
+                             COLLIDE_ENTRIES);                                \
+        }                                                                     \
+        break;                                                                \
+    }
+#else
+#define COLLIDE_ENTRIES 16
+#define COLLIDE_FULL(count)
+#endif
+
 static Uint32 player_collide_world(struct task_work *work,
                                    struct task_motion *motion,
                                    struct player *record);
