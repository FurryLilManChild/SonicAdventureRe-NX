diff --git a/engine/pc/shaders/draw.vert b/engine/pc/shaders/draw.vert
index f4d40a3..a571d48 100644
--- a/engine/pc/shaders/draw.vert
+++ b/engine/pc/shaders/draw.vert
@@ -2,7 +2,7 @@
 // a corner of a draw, in world space, or under BATCH_SCREEN at the screen's
 // pixels with its view z. the screen is 640 by 480, and a point shows at
 // center + focal * (x, y) / z in view space, z ahead. depth is 1/z, as the
-// PowerVR compares it, so z = 1 is the near plane
+// PowerVR compares it, times DEPTH_SCALE; z = 1 is the world's near plane
 layout(set = 0, binding = 0) uniform Picture {
     vec4 view[3]; // world to view, by rows
     vec4 project; // focal x and y, center x and y
@@ -30,6 +30,7 @@ out gl_PerVertex {
 
 const uint BATCH_SCREEN = 16u;
 const uint BATCH_NEAR = 256u; // clip at the near clip, not at z = 1
+const float DEPTH_SCALE = 1.0 / 256.0;
 
 void main()
 {
@@ -43,8 +44,15 @@ void main()
     } else {
         screen = at.xy * view.z;
     }
-    gl_Position = vec4(screen.x / 320.0 - view.z, screen.y / 240.0 - view.z, 1.0, view.z);
-    gl_ClipDistance[0] = (batch.flags & BATCH_NEAR) != 0u ? view.z - picture.fog.y : 1.0;
+    // depth is 1/z scaled by DEPTH_SCALE, a power of two, so every compare
+    // and the blend list's order stay as they were. the PowerVR takes a 2D
+    // draw nearer than z = 1 (the pause menu's tiles lie at 1/z = 10), so
+    // the scale leaves room for 1/z up to 1/DEPTH_SCALE. a draw in the world
+    // is still cut at z = 1, by the clip distance in place of depth's range
+    gl_Position = vec4(screen.x / 320.0 - view.z, screen.y / 240.0 - view.z, DEPTH_SCALE, view.z);
+    gl_ClipDistance[0] = (batch.flags & BATCH_SCREEN) != 0u
+                             ? 1.0
+                             : view.z - ((batch.flags & BATCH_NEAR) != 0u ? max(1.0, picture.fog.y) : 1.0);
     out_uv = uv;
     out_base = base;
     out_offset = offset;
