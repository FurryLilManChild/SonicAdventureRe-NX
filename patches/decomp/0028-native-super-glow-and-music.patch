+#if defined(NONMATCHING) && !defined(DREAMCAST)
+/* SonicAdventureRe-nx: super Sonic's charge glows gold, its red and blue
+ * swapped */
+static void aura_color_super(NJS_ARGB *color, struct player *record)
+{
+    NJS_ARGB gold = *color;
+
+    if (record->upgrades & PLAYER_SONIC_SUPER) {
+        gold.r = color->b;
+        gold.b = color->r;
+    }
+    njSetConstantMaterial(&gold);
+}
