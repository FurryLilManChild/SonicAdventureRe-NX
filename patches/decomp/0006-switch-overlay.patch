+void Raster::Impl::overlay_onto(VkCommandBuffer c, Frame &f, VkImage to,
+                                const VkRect2D &shows)
+{
+    uint32_t ow = 0, oh = 0;
+    int32_t ox = 0, oy = 0;
+    const uint8_t *over =
+        native_overlay ? native_overlay(ow, oh, ox, oy, shows.extent.width,
+                                        shows.extent.height)
+                       : nullptr;
+    std::string lost;
+    constexpr VkDeviceSize most = 640 * 480 * 4;
+
+    if (over == nullptr || ow == 0 || oh == 0 || ox < 0 || oy < 0 ||
+        ox + static_cast<int64_t>(ow) > shows.extent.width ||
+        oy + static_cast<int64_t>(oh) > shows.extent.height ||
+        static_cast<VkDeviceSize>(ow) * oh * 4 > most) {
+        return;
+    }
+    if (f.overlay.buffer == VK_NULL_HANDLE &&
+        !make_buffer(f.overlay, most, VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+                     lost)) {
+        return;
+    }
+    VkBufferImageCopy place{};
+
+    memcpy(f.overlay.mapped, over, static_cast<size_t>(ow) * oh * 4);
+    barrier(c, to, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, 1,
+            VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+            VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    place.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    place.imageOffset = {shows.offset.x + ox, shows.offset.y + oy, 0};
+    place.imageExtent = {ow, oh, 1};
+    vk.vkCmdCopyBufferToImage(c, f.overlay.buffer, to,
+                              VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &place);
+}
