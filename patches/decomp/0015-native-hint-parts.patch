+         * or until a button */
+        const char *parts[4];
+        int count = native_hook_hint_parts(text, parts, 4);
+        int k;
+
+        for (k = 0; k < count && !message_cut_short; k++) {
+            message_show(&message_window, (char *)parts[k]);
+            if (pages->steps) {
+                WAIT_STEPS(&message_window, pages->steps * (k + 1) / count -
+                                                pages->steps * k / count);
+            } else {
+                message_wait_button(&message_window);
+            }
+        }
+#else
         message_show(&message_window, text);
         if (pages->steps) {
             WAIT_STEPS(&message_window, pages->steps);
         } else {
             message_wait_button(&message_window);
         }
+#endif
         pages++;
     }
     message_finish(&message_window);
