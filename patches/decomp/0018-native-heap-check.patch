+#if defined(NONMATCHING) && !defined(DREAMCAST)
+/* the heap check: after each heap_alloc and heap_free, the free list is
+ * walked and each link tested (in the arena, on a 16-byte boundary, linked
+ * back). the first damage found is told to the host with the step that was
+ * running, the caller, and the freed block that last held the damaged bytes,
+ * since a write through a freed pointer is the likeliest cause. a free of a
+ * block not in use, or not in the arena, is told the same way */
+#define HEAP_FREES 4096
+static struct {
+    Uint8 *start;
+    Uint8 *end;
+    void *caller;
+    void *step;
+} heap_frees[HEAP_FREES];
+static int heap_frees_next;
+static int heap_damage_told;
+
+static Bool heap_in_arena(const void *p)
+{
+    const Uint8 *b = p;
+
+    return b >= heap_arena && b <= heap_arena + HEAP_SIZE &&
+           ((b - heap_arena) & 15) == 0;
+}
+
+static void heap_tell(const char *what, const void *at, unsigned long value,
+                      void *caller)
+{
+    void *freed_by = NULL;
+    void *freed_step = NULL;
+    int i;
+    int k;
+
+    if (heap_damage_told >= 8) {
+        return;
+    }
+    heap_damage_told++;
+    for (i = 0; i < HEAP_FREES; i++) {
+        k = (heap_frees_next - 1 - i + HEAP_FREES) % HEAP_FREES;
+        if (heap_frees[k].start != NULL &&
+            (const Uint8 *)at >= heap_frees[k].start &&
+            (const Uint8 *)at < heap_frees[k].end) {
+            freed_by = heap_frees[k].caller;
+            freed_step = heap_frees[k].step;
+            break;
+        }
+    }
+    native_hook_heap_damage(what, (unsigned long)(Uint8 *)at, value, caller,
+                            (void *)task_current_root_step, freed_by,
+                            freed_step);
+}
+
+static void heap_check(void *caller)
+{
+    struct heap_block *block;
+    int count = 0;
+
+    if (heap_damage_told >= 8) {
+        return;
+    }
+    for (block = heap_free_list; block != NULL; block = block->next) {
+        if (!heap_in_arena(block)) {
+            heap_tell("a free block outside the heap", block, 0, caller);
+            return;
+        }
+        if (block->next != NULL &&
+            (!heap_in_arena(block->next) || block->next->prev != block)) {
+            heap_tell("a free block's next", &block->next,
+                      (unsigned long)(Uint8 *)block->next, caller);
+            return;
+        }
+        if (block->after != NULL && (!heap_in_arena(block->after) ||
+                                     block->after->before != block)) {
+            heap_tell("a free block's after", &block->after,
+                      (unsigned long)(Uint8 *)block->after, caller);
+            return;
+        }
+        if (++count > 100000) {
+            heap_tell("the free list loops", block, 0, caller);
+            return;
+        }
+    }
+}
+#define HEAP_CHECK() heap_check(__builtin_return_address(0))
+#else
+#define HEAP_CHECK() ((void)0)
+#endif
+
+#if defined(NONMATCHING) && !defined(DREAMCAST)
+static void *heap_alloc_unchecked(int size);
+
+void *heap_alloc(int size)
+{
+    void *mem = heap_alloc_unchecked(size);
+
+    HEAP_CHECK();
+    return mem;
+}
