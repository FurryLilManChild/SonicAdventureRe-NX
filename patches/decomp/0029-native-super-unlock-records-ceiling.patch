index 1fec5ad..d5ecba8 100644
--- a/src/collision/world.c
+++ b/src/collision/world.c
@@ -1248,6 +1248,47 @@ void world_compute_bounds(void)
     }
 }
 
+#if defined(NONMATCHING) && !defined(DREAMCAST)
+/* the port's super Sonic (sonic.c): the highest point of the act's solid
+ * land, for his flight's ceiling. each solid entry's points, placed as
+ * world_compute_bounds places its center. FALSE with no land loaded */
+int native_world_land_top(Float *top)
+{
+    Sint16 i;
+    Uint32 k;
+    struct land_entry *entry;
+    NJS_OBJECT *object;
+    NJS_MODEL *model;
+    NJS_POINT3 point;
+    int found = FALSE;
+
+    if (world_land == NULL) {
+        return FALSE;
+    }
+    for (i = 0; i < world_land->count; i++) {
+        entry = &world_land->entries[i];
+        object = entry->object;
+        if (!(entry->flags & WORLD_SOLID) || object == NULL ||
+            (model = object->model) == NULL || model->points == NULL) {
+            continue;
+        }
+        njPushMatrix(&_unit_matrix_);
+        njTranslate(NULL, object->pos[0], object->pos[1], object->pos[2]);
+        TURN(njRotateX, object->ang[0]);
+        TURN(njRotateY, object->ang[1]);
+        for (k = 0; k < (Uint32)model->nbPoint; k++) {
+            njCalcPoint(NULL, &model->points[k], &point);
+            if (!found || point.y > *top) {
+                *top = point.y;
+                found = TRUE;
+            }
+        }
+        njPopMatrix(1);
+    }
+    return found;
+}
+#endif
