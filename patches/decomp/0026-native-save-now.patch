+#if defined(NONMATCHING) && !defined(DREAMCAST)
+/* a host's "save now" (SonicAdventureRe-nx's port menu): each frame an
+ * adventure field plays in a story, the host learns whether it may save
+ * there, and when it asks, the story is saved as a character notice saves
+ * it, at the field and its last entrance */
+int native_hook_save_now(int can);
+void native_hook_save_done(int result);
+
+static void field_save_now(void)
+{
+    int stage = stage_get_stage_act() >> 8;
+    int can = player_record != NULL && player_record->section >= 0 &&
+              !event_in_control() && stage >= STAGE_STATION_SQUARE &&
+              stage <= STAGE_PAST;
+
+    if (native_hook_save_now(can) && can) {
+        player_record->stage_act = stage_get_stage_act();
+        /* NOLINTNEXTLINE(bugprone-signed-char-misuse) */
+        player_record->entrance = stage_get_entrance();
+        native_hook_save_done(save_write_wait());
+    }
+}
+#endif
