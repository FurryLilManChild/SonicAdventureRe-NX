diff --git a/engine/native/a64.c b/engine/native/a64.c
new file mode 100644
index 0000000..43440ce
--- /dev/null
+++ b/engine/native/a64.c
@@ -0,0 +1,30 @@
+/* SonicAdventureRe-nx: what an AArch64 build of the native slice needs from
+ * its host code. Its C is read as x86-64's, for 32-bit references, with the
+ * Microsoft va_list (a pointer walking 8-byte slots) in place of SysV's, so
+ * that AArch64's backend can run it. The C library's vsprintf takes
+ * AArch64's va_list, whose arguments come from __stack alone once both of its
+ * register offsets are 0 or more: 8-byte slots, as the Microsoft list's are */
+#ifdef NATIVE_A64
+struct a64_va_list {
+    void *stack;
+    void *gr_top;
+    void *vr_top;
+    int gr_offs;
+    int vr_offs;
+};
+
+/* AArch64 passes a va_list, 32 bytes, by a pointer to a copy. The C library's
+ * vsprintf under another name, which clang's builtin of the name won't take */
+int a64_libc_vsprintf(char *s, const char *format, struct a64_va_list *args)
+    __asm__("vsprintf");
+
+int native_a64_vsprintf(char *s, const char *format, char *args);
+int native_a64_vsprintf(char *s, const char *format, char *args)
+{
+    struct a64_va_list list = {args, 0, 0, 0, 0};
+
+    return a64_libc_vsprintf(s, format, &list);
+}
+#else
+typedef int native_a64_empty;
+#endif
diff --git a/engine/native/native.h b/engine/native/native.h
index 45d6835..dbe3911 100644
--- a/engine/native/native.h
+++ b/engine/native/native.h
@@ -117,7 +117,26 @@ extern struct sa_engine *native_sound_engine;
  * the SH-4 does. native_fpu_host loads it and returns the game's MXCSR, which
  * native_fpu_game loads back as the call returns */
 #define DEFAULT_MXCSR 0x1f80U
-#ifdef __SSE__
+#if defined(NATIVE_A64) || defined(__aarch64__)
+/* SonicAdventureRe-nx: AArch64's FPCR in MXCSR's place. Its reset value, 0,
+ * rounds to nearest with no flushing; the game's (runner.c's set_fpu) rounds
+ * toward zero and flushes. The asm is AArch64's even where the C was read as
+ * x86's: only AArch64's backend sees it */
+#define DEFAULT_FPCR 0U
+static inline uint32_t native_fpu_host(void)
+{
+    unsigned long long game;
+
+    __asm__ volatile("mrs %0, fpcr" : "=r"(game));
+    __asm__ volatile("msr fpcr, %0" : : "r"((unsigned long long)DEFAULT_FPCR));
+    return (uint32_t)game;
+}
+
+static inline void native_fpu_game(uint32_t game)
+{
+    __asm__ volatile("msr fpcr, %0" : : "r"((unsigned long long)game));
+}
+#elif defined(__SSE__)
 static inline uint32_t native_fpu_host(void)
 {
     uint32_t game = __builtin_ia32_stmxcsr();
diff --git a/engine/native/runner.c b/engine/native/runner.c
index 5c9f34f..11e753c 100644
--- a/engine/native/runner.c
+++ b/engine/native/runner.c
@@ -162,7 +162,16 @@ static void map_domain(void)
     native_threads_reserve();
     /* x86's RET, which the P2 calls reach */
     native_map(ret, P2_CALL_SIZE, "the P2 calls");
+#if defined(NATIVE_A64)
+    /* SonicAdventureRe-nx: AArch64's RET */
+    *(unsigned int *)ret = 0xd65f03c0U;
+    /* its line to the point of unification, then the instruction cache's, as
+     * __clear_cache would, without the library call the stubs can't place */
+    __asm__ volatile("dc cvau, %0\n\tdsb ish\n\tic ivau, %0\n\tdsb ish\n\tisb"
+                     : : "r"(ret) : "memory");
+#else
     *(unsigned char *)ret = 0xc3;
+#endif
     if (!code(ret, P2_CALL_SIZE)) {
         unmapped("the P2 calls", ret);
     }
@@ -179,6 +188,19 @@ static void map_domain(void)
 /* the game's FPSCR rounds toward zero and flushes a denormal result, as
  * MXCSR's RC and FTZ do. DAZ stays clear, so a denormal operand keeps its
  * value, as math.c's default build reads it */
+#if defined(NATIVE_A64)
+/* SonicAdventureRe-nx: FPCR's RMode (bits 23:22) 3 rounds toward zero, and FZ
+ * (bit 24) flushes denormals, a result's as FTZ does and an operand's too,
+ * which MXCSR leaves to DAZ */
+static void set_fpu(void)
+{
+    unsigned long long fpcr;
+
+    __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr));
+    fpcr |= (3ULL << 22) | (1ULL << 24);
+    __asm__ volatile("msr fpcr, %0" : : "r"(fpcr));
+}
+#else
 static void set_fpu(void)
 {
     unsigned int csr = __builtin_ia32_stmxcsr();
@@ -186,6 +208,7 @@ static void set_fpu(void)
     csr &= ~MXCSR_DAZ;
     __builtin_ia32_ldmxcsr(csr);
 }
+#endif
 
