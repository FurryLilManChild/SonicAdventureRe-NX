+#if defined(NONMATCHING) && !defined(DREAMCAST)
+/* Station Square's row of each character's voiced hints for its story so
+ * far (its hint box of them), which TALK plays in every field */
+#define TALK_ROW 18
+
+void script_native_talk(void)
+{
+    static struct script_pages pick;
+    const struct script_row *row;
+    int stage;
+    void *run;
+
+    if (!native_hook_talk()) {
+        return;
+    }
+    stage = STAGE_OF(stage_get_stage_act());
+    if (stage < STAGE_STATION_SQUARE || stage > STAGE_PAST ||
+        stage_paused() || event_in_control() || message_busy()) {
+        return;
+    }
+    row = &station_square_script_table[TALK_ROW];
+    pick.voice = -1;
+    pick.flag = -1;
+    pick.pages = NULL;
+    run = script_run(&pick, row->script, row->runs, RUNS_PAGES);
+    if (run == NULL) {
+        return;
+    }
+    pick.pages = run == NO_RUNS ? NULL : run;
+    if (pick.voice > -1 || pick.pages != NULL) {
+        script_show(&pick);
+    }
+}
+#endif
