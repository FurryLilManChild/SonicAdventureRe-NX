+static int idle_voice(void)
+{
+    int stage_act = stage_get_stage_act();
+    int stage = STAGE_OF(stage_act);
+    int act = stage_act & 0xff;
+    int character = get_character();
+    const struct idle_line *line;
+    unsigned int i;
+
+    if (character < 0 || character > 7) {
+        return -1;
+    }
+    if (rand() * RAND_SCALE >= 0.5F) {
+        for (i = 0; i < sizeof idle_lines / sizeof *idle_lines; i++) {
+            line = &idle_lines[i];
+            if (line->stage != stage || line->character != character) {
+                continue;
+            }
+            if (stage >= STAGE_ALIFE_SS && stage <= STAGE_ALIFE_MR) {
+                return line->voice[(int)(rand() * RAND_SCALE * line->count)];
+            }
+            return line->voice[act < line->count ? act : line->count - 1];
+        }
+    }
+    if (stage == STAGE_CHAOS7 && character == CHARACTER_SONIC) {
+        return IDLE_GENERAL_SONIC_19;
+    }
+    return idle_general[character];
+}
+
+void script_native_talk(Bool playing)
+{
+    static int last_idle;
+    struct player *record;
+    int talk = native_hook_talk();
+    int idle;
+    Bool fidget;
+
+    if (!playing || player_work[0] == NULL ||
+        (record = player_get(0)) == NULL) {
+        last_idle = 0;
+        return;
+    }
+    idle = record->idle_steps;
+    fidget = native_hook_idle_lines() && last_idle > IDLE_STEPS &&
+             idle < last_idle;
+    last_idle = idle;
+    if ((!talk && !fidget) || stage_paused() || event_in_control() ||
+        message_busy()) {
+        return;
+    }
+    idle = idle_voice();
+    if (idle >= 0) {
+        stream_request_voice(idle);
+    }
+}
