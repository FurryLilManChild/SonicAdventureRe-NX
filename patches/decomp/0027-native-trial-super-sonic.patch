             njSetTexture(&super_sonic_texlist);
         } else {
             njSetTexture(&sonic_texlist);
@@ -7457,8 +7644,14 @@
      * top_speed and ground_accel (FMOV.S at 0x8c0ba198, 0x8c0ba1a0), not
