 /* choose his mode for this step, then move, pose and draw him by it */
+#if defined(NONMATCHING) && !defined(DREAMCAST)
+/* the port's Super Sonic in trial mode (SonicAdventureRe-nx, docs/
+ * super-sonic-trial-plan.md). with TRIAL_SUPER_RINGS rings or more, the
+ * action button in a jump turns him super; again, or with no rings left,
+ * he turns back. while super he keeps his own modes and moves, drawn on
+ * super Sonic's model with super Sonic's textures, and loses a ring each
+ * TRIAL_SUPER_DRAIN steps, as the last boss's fight drains them. the first
+ * test: Emerald Coast's first act in a trial only */
+#define TRIAL_SUPER_RINGS 50
+#define TRIAL_SUPER_DRAIN 60
+#define SONIC_ACTION_ROWS (sizeof sonic_actions / sizeof sonic_actions[0])
+
+static struct player_action trial_super_actions[SONIC_ACTION_ROWS];
+static NJS_ACTION trial_super_rows[SONIC_ACTION_ROWS];
+static Bool trial_super_made;
+static Bool trial_super_textures;
+/* his constants before the speed shoes' doubling (player.c's
+ * player_speed_up_start), put back when he turns back */
+static Float trial_super_ground_accel, trial_super_top_speed,
+    trial_super_still_grip;
+static Bool trial_super_on;
+/* the music before the super theme, asked for again when he turns back */
+static int trial_super_music = -1;
+int native_stream_music_current(void);
+static int trial_super_steps;
+
+static Bool trial_super_here(void)
+{
+    return game_mode == GAME_MODE_TRIAL &&
+           STAGE_OF(stage_get_stage_act()) == STAGE_BEACH;
+}
+
+/* sonic_actions again, with super Sonic's model in each row that plays on
+ * Sonic's own (the two share his nodes, as super Sonic's rows that play
+ * Sonic's motions show) */
+static void trial_super_make(void)
+{
+    Uint32 i;
+
+    for (i = 0; i < SONIC_ACTION_ROWS; i++) {
+        trial_super_actions[i] = sonic_actions[i];
+        if (sonic_actions[i].action != NULL &&
+            sonic_actions[i].action->object ==
+                sonic_stand_action.object) {
+            trial_super_rows[i].object = &super_sonic_object;
+            trial_super_rows[i].motion = sonic_actions[i].action->motion;
+            trial_super_actions[i].action = &trial_super_rows[i];
+        }
+        if (sonic_actions[i].nodes == BALL_NODES ||
+            sonic_actions[i].nodes == SPIN_NODES) {
+            /* his ball, spin and roll: super Sonic's own ball */
+            trial_super_actions[i].action = &super_sonic_ball_action;
+            trial_super_actions[i].nodes = BALL_NODES;
+        }
+    }
+    /* at speed he flies, in super Sonic's run (his flight in the last
+     * boss's fight), each holding its own row's place */
+    trial_super_actions[ACTION_SPRINT].action = &super_sonic_run_action;
+    trial_super_actions[ACTION_SPRINT].mode = PLAYER_ANIM_LOOP;
+    trial_super_actions[ACTION_SPRINT].speed = 0.5F;
+    trial_super_actions[ACTION_FULL_SPEED].action = &super_sonic_run_action;
+    trial_super_actions[ACTION_FULL_SPEED].mode = PLAYER_ANIM_LOOP;
+    trial_super_actions[ACTION_FULL_SPEED].speed = 0.5F;
+    trial_super_made = TRUE;
+}
+
+static void trial_super_begin(struct task_work *work, struct player *record)
+{
+    struct task *task;
+
+    if (!trial_super_made) {
+        trial_super_make();
+    }
+    if (!trial_super_textures) {
+        texture_load_pvm("SUPERSONIC", &super_sonic_texlist);
+        trial_super_textures = TRUE;
+    }
+    record->upgrades |= PLAYER_SONIC_SUPER;
+    task = task_create(TASK_WORK, 2, super_aura_start);
+    if (task != NULL) {
+        PLAYER_VARS(task->work)->player = PLAYER_VARS(work)->player;
+    }
+    /* as fast as with the speed shoes, as the classic games' super form */
+    trial_super_ground_accel = record->consts.ground_accel;
+    trial_super_top_speed = record->consts.top_speed;
+    trial_super_still_grip = record->consts.still_grip;
+    record->consts.ground_accel *= 2.0F;
+    record->consts.top_speed *= 2.0F;
+    record->consts.still_grip *= 2.0F;
+    record->anim.actions = trial_super_actions;
+    trial_super_on = TRUE;
+    trial_super_steps = 0;
+    trial_super_music = native_stream_music_current();
+    stream_request_music(MUSIC_SPRSONIC);
+    native_hook_note("trial super: on, rings", ring_count(), 0);
+}
+
+/* the super form ends: his own rows, welds and music again. the super task
+ * puts back his constants as it ends, on its next step */
+static void trial_super_end(struct player *record)
+{
+    record->upgrades &= ~PLAYER_SONIC_SUPER;
+    record->anim.actions = sonic_actions;
+    record->consts.ground_accel = trial_super_ground_accel;
+    record->consts.top_speed = trial_super_top_speed;
+    record->consts.still_grip = trial_super_still_grip;
+    trial_super_on = FALSE;
+    if (trial_super_music != -1) {
+        stream_request_music(trial_super_music);
+    }
+    native_hook_note("trial super: off, rings", ring_count(), 0);
+}
+
+/* TRUE when a press turned him super or back, taking the step's choice */
+/* flying: no gravity; the stick steers him as the camera sees it, up to his
+ * top speed; the jump button (Dreamcast A) held climbs, Y held descends */
+#define TRIAL_FLY_TURN 0x800
+#define TRIAL_FLY_SLOW 0.92F
+
+static void trial_super_fly_end(struct task_work *work)
+{
+    work->mode = SONIC_FALL;
+}
+
+static void trial_super_fly(struct task_work *work, struct task_motion *motion,
+                            struct player *record)
+{
+    Uint32 on = pad_records[PLAYER_VARS(work)->player].on;
+    Angle ang;
+    Float stroke;
+    Float want;
+
+    work->flags &= ~PLAYER_BALL;
+    work->ang.x = 0;
+    work->ang.z = 0;
+    record->accel.x = record->accel.y = record->accel.z = 0.0F;
+    if (player_read_stick(work, &ang, &stroke) && stroke > 0.0F) {
+        work->ang.y = angle_approach(work->ang.y, ang, TRIAL_FLY_TURN);
+        want = record->consts.top_speed * stroke;
+        if (record->speed.x < want) {
+            record->speed.x += record->consts.ground_accel;
+            if (record->speed.x > want) {
+                record->speed.x = want;
+            }
+        } else {
+            record->speed.x *= TRIAL_FLY_SLOW;
+        }
+    } else {
+        record->speed.x *= TRIAL_FLY_SLOW;
+    }
+    record->speed.z = 0.0F;
+    if (on & PDD_DGT_TA) {
+        record->speed.y = record->consts.jump_speed * 0.5F;
+    } else if (on & PDD_DGT_TY) {
+        record->speed.y = -record->consts.jump_speed * 0.5F;
+    } else {
+        record->speed.y = 0.0F;
+    }
+    record->anim.action = ACTION_FULL_SPEED;
+    (void)motion;
+}
+
+/* the trial super's buttons, in a jump (Dreamcast buttons): X turns him
+ * super, or back; super, B starts flight. flying, B or landing ends it.
+ * TRUE when this step's mode is chosen here */
+static Bool trial_super_step(struct task_work *work, struct task_motion *motion,
+                             struct player *record)
+{
+    Uint32 press;
+    Bool jumping;
+    Bool flying;
+
+    if (trial_super_on && !(record->upgrades & PLAYER_SONIC_SUPER)) {
+        /* something else ended it, as a fall down does */
+        trial_super_end(record);
+        if (work->mode == SONIC_FLY) {
+            trial_super_fly_end(work);
+        }
+        return FALSE;
+    }
+    if (PLAYER_VARS(work)->player != 0 ||
+        (!trial_super_on && !trial_super_here())) {
+        return FALSE;
+    }
+    if (trial_super_on && native_stream_music_current() != MUSIC_SPRSONIC) {
+        /* the stage asked for music of its own (a new act): that is the
+         * music to go back to, and the super theme plays on */
+        trial_super_music = native_stream_music_current();
+        stream_request_music(MUSIC_SPRSONIC);
+    }
+    press = pad_records[PLAYER_VARS(work)->player].press;
+    jumping = work->mode == SONIC_JUMP;
+    flying = work->mode == SONIC_FLY;
+    if ((jumping || flying) && (press & (PDD_DGT_TX | PDD_DGT_TB))) {
+        native_hook_note(press & PDD_DGT_TX ? "trial super: X, rings"
+                                            : "trial super: B, rings",
+                         ring_count(), trial_super_on ? 1 : 0);
+    }
+    if (!trial_super_on) {
+        if (jumping && (press & PDD_DGT_TX) &&
+            ring_count() >= TRIAL_SUPER_RINGS) {
+            trial_super_begin(work, record);
+            return TRUE;
+        }
+        return FALSE;
+    }
+    if (++trial_super_steps >= TRIAL_SUPER_DRAIN) {
+        trial_super_steps = 0;
+        if (ring_count() > 0) {
+            ring_add(-1);
+        }
+    }
+    if (ring_count() <= 0 || ((jumping || flying) && (press & PDD_DGT_TX))) {
+        trial_super_end(record);
+        if (flying) {
+            trial_super_fly_end(work);
+        }
+        return flying || jumping;
+    }
+    if (jumping && (press & PDD_DGT_TB)) {
+        work->mode = SONIC_FLY;
+        record->speed.y = 0.0F;
+        native_hook_note("trial super: flight on, rings", ring_count(), 0);
+        trial_super_fly(work, motion, record);
+        return TRUE;
+    }
+    if (flying) {
+        if ((press & PDD_DGT_TB) || (work->flags & PLAYER_ON_GROUND)) {
+            native_hook_note("trial super: flight off, rings", ring_count(), 0);
+            trial_super_fly_end(work);
+            return FALSE;
+        }
+        trial_super_fly(work, motion, record);
+        return TRUE;
+    }
+    return FALSE;
+}
