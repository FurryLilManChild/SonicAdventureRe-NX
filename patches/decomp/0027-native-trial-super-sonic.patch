+        njReleaseTexture(&super_sonic_texlist);
+        trial_super_textures = FALSE;
+    }
+    if (trial_super_on) {
+        trial_super_welds(WELD_OFF);
+        trial_super_on = FALSE;
+    }
+#endif
 }
 
